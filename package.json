{
  "name": "fotoformal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ubah foto apa pun menjadi foto formal (pas foto / ijazah / lamaran kerja) dengan latar belakang dan pakaian formal pilihan, tanpa mengubah wajah dan tubuh.",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"node --watch server/index.js\" \"npm --prefix client run dev\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "node --watch server/index.js",
    "build": "npm --prefix client run build",
    "preview": "npm --prefix client run preview",
    "start": "node server/index.js",
    "setup": "npm install && npm --prefix client install",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/smoke-mount.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FostKarlLyle/FotoFormal.git"
  },
  "keywords": [
    "foto-formal",
    "pas-foto",
    "ai",
    "gemini",
    "image-editing"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FostKarlLyle/FotoFormal/issues"
  },
  "homepage": "https://github.com/FostKarlLyle/FotoFormal#readme",
  "dependencies": {
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "jsdom": "^30.1.2"
  }
}
