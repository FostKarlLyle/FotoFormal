# ============================================================
# FotoFormal — konfigurasi opsional
# Copy file ini menjadi .env lalu isi sesuai kebutuhan.
# ============================================================

# Port server Express (default 8787)
PORT=8787

# ------------------------------------------------------------
# OPSIONAL: Mode "server key"
# Kalau diisi, aplikasi bisa memanggil AI dari sisi server sehingga
# API key tidak perlu ditempel di browser pengguna.
# Kosongkan saja kalau pengguna mau memakai API key masing-masing
# (mode default, aman untuk aplikasi publik).
#
# Ambil API key gratis/berbayar di: https://aistudio.google.com/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=

# Model default yang dipakai untuk penggantian pakaian + latar.
# Pilihan yang didukung aplikasi ini:
#   gemini-2.5-flash-image        (Nano Banana, klasik)
#   gemini-3.1-flash-lite-image   (Nano Banana 2 Lite, paling cepat/murah)
#   gemini-3.1-flash-image        (Nano Banana 2, kualitas terbaik)
#   gemini-3-pro-image            (Nano Banana Pro)
GEMINI_MODEL=gemini-2.5-flash-image

# Aktifkan proxy AI di server (true/false).
# false = panggilan AI langsung dari browser memakai API key pengguna.
ENABLE_SERVER_AI=false
